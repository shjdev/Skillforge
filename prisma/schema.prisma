// Prisma Schema for SkillForge (PostgreSQL — Neon en prod, Docker en local)
//
// Tout le contenu appartient à un utilisateur : Livre → Thèmes → Leçons + Quiz.
// Aucun catalogue commun. Supprimer un profil supprime tout son contenu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon's PgBouncer-compatible endpoint) — used at runtime.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection — used by `prisma db push`/`migrate` for DDL.
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id                   String    @id @default(uuid())
  name                 String    @default("Apprenant")
  sessionMode          String    @default("TWO_SESSIONS") // "TWO_SESSIONS" | "ONE_SESSION"
  morningTime          String    @default("07:30")
  eveningTime          String    @default("20:00")
  singleSessionTime    String    @default("19:00")
  /// Un seul thème actif à la fois, jusqu'à la réussite de son quiz.
  currentActiveTopicId String?
  totalXp              Int       @default(0)
  currentStreak        Int       @default(0)
  lastSessionDate      String? // YYYY-MM-DD
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  categories           Category[]
  books                Book[]
  topics               Topic[]
  importJobs           ImportJob[]
  progresses           UserProgress[]
  sessions             UserSession[]
  quizAttempts         QuizAttempt[]
  notificationSettings NotificationSettings?
  credential           UserCredential?
}

/// Mot de passe personnel d'un testeur. Table séparée pour que le hash ne
/// remonte jamais dans les réponses API qui renvoient le profil.
model UserCredential {
  userId       String      @id
  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String // "scrypt$<salt hex>$<hash hex>"
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

/// Étiquette de classement, attribuée automatiquement à l'import (ex. « Réseau »).
model Category {
  id        String      @id @default(uuid())
  ownerId   String
  owner     UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())

  books Book[]

  @@unique([ownerId, name])
}

/// Un fichier importé, transformé en parcours.
model Book {
  id         String      @id @default(uuid())
  ownerId    String
  owner      UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title      String
  author     String      @default("")
  summary    String      @default("")
  fileName   String      @default("")
  status     String      @default("GENERATING") // "GENERATING" | "READY" | "ERROR"
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  topics     Topic[]
  importJobs ImportJob[]

  @@index([ownerId, createdAt])
}

/// Une partie du livre (un ou plusieurs chapitres), validée par un quiz.
model Topic {
  id                 String      @id @default(uuid())
  ownerId            String
  owner              UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookId             String
  book               Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  slug               String
  name               String
  description        String      @default("")
  position           Int // ordre dans le livre, à partir de 1
  maxDifficultyLevel Int         @default(3) // 1 : débutant → 5 : expert
  chunkStart         Int // premier extrait du livre couvert (inclus)
  chunkEnd           Int // dernier extrait couvert (inclus)
  status             String      @default("PENDING") // "PENDING" | "GENERATING" | "READY" | "ERROR"

  lessons        Lesson[]
  quiz           Quiz?
  userProgresses UserProgress[]

  @@unique([ownerId, slug])
  @@index([bookId, position])
}

model Lesson {
  id              String   @id @default(uuid())
  topicId         String
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title           String
  contentMd       String
  dayNumber       Int // jour dans le thème, à partir de 1
  sessionType     String // "MORNING" (théorie) | "EVENING" (pratique) | "FULL_DAY"
  difficultyLevel Int      @default(1) // 1 à 5
  durationMinutes Int      @default(30)
  keyConcepts     Json     @default("[]") // string[]
  chapterCitation String?
  createdAt       DateTime @default(now())

  userSessions UserSession[]

  @@index([topicId, dayNumber])
}

/// Quiz de validation d'un thème (un par thème).
model Quiz {
  id           String         @id @default(uuid())
  topicId      String         @unique
  topic        Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int            @default(80) // pourcentage

  questions    QuizQuestion[]
  quizAttempts QuizAttempt[]
}

model QuizQuestion {
  id            String @id @default(uuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  dayNumber     Int    @default(1) // jour du thème dont la question est issue
  questionText  String
  options       Json // string[]
  correctAnswer String
  explanation   String @default("")
  points        Int    @default(10)

  @@index([quizId])
}

model QuizAttempt {
  id          String      @id @default(uuid())
  userId      String
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int
  maxScore    Int
  percentage  Float
  passed      Boolean
  answers     Json // { [questionId]: réponse choisie }
  attemptedAt DateTime    @default(now())

  @@index([userId, quizId])
}

model UserProgress {
  id            String      @id @default(uuid())
  userId        String
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId       String
  topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  currentDay    Int         @default(1)
  status        String      @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED"
  completionPct Float       @default(0)
  startedAt     DateTime    @default(now())
  completedAt   DateTime?

  @@unique([userId, topicId])
}

/// Une leçon faite par l'apprenant.
model UserSession {
  id              String      @id @default(uuid())
  userId          String
  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sessionType     String // "MORNING" | "EVENING" | "ACCUMULATED"
  scheduledAt     DateTime
  completedAt     DateTime?
  durationSeconds Int         @default(0)
  completed       Boolean     @default(false)
  wasAccumulated  Boolean     @default(false)
  notes           String?

  @@index([userId, completed, completedAt])
}

model NotificationSettings {
  id                   String      @id @default(uuid())
  userId               String      @unique
  user                 UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  desktopEnabled       Boolean     @default(true)
  soundEnabled         Boolean     @default(true)
  morningReminderMins  Int         @default(5)
  eveningReminderMins  Int         @default(5)
  accumulationReminder Boolean     @default(true)
  streakReminder       Boolean     @default(true)
}

/// Import d'un fichier, de l'analyse à la fin de la génération. Garde le
/// texte découpé et la file des extraits à générer pour pouvoir reprendre.
model ImportJob {
  id               String      @id @default(uuid())
  ownerId          String
  owner            UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookId           String?
  book             Book?       @relation(fields: [bookId], references: [id], onDelete: SetNull)
  status           String      @default("ANALYZING") // "ANALYZING" | "REVIEW" | "GENERATING" | "DONE" | "ERROR" | "CANCELLED"
  fileName         String
  fileSize         Int         @default(0)
  /// Texte découpé (string[]), vidé une fois la génération terminée.
  chunks           Json        @default("[]")
  /// Résultat de l'analyse IA (titre, auteur, catégorie, thèmes, plan par extrait).
  analysis         Json?
  /// File des extraits à générer : [{ topicId, chunk, dayNumber }]
  queue            Json        @default("[]")
  cursor           Int         @default(0)
  /// Échecs consécutifs sur l'extrait courant (au-delà de 3, il est ignoré).
  failures         Int         @default(0)
  skippedChunks    Json        @default("[]") // number[]
  /// Dernière leçon théorique générée, pour la continuité d'un jour à l'autre.
  lastGenerated    Json?
  lessonsCreated   Int         @default(0)
  questionsCreated Int         @default(0)
  error            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([ownerId, createdAt])
}
