# Copy this file to .env and fill in the values you need.

# Required — PostgreSQL connection strings from your Neon project
# (Dashboard > Connect). DATABASE_URL is the pooled endpoint (hostname ends
# in "-pooler"), used at runtime; DIRECT_URL is the unpooled one, used by
# `prisma db push` for schema changes. Both include `?sslmode=require` when
# copied from Neon — keep that.
DATABASE_URL=
DIRECT_URL=

# Optional: enables AI-assisted book analysis and lesson/quiz generation
# (Bibliothèque & Admin > Bibliothèque), including Gemini Vision OCR fallback
# for scanned PDFs. Without it, PDF import still works but only adds the book
# reference — no lessons are generated. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for PDF import on Vercel: book files are uploaded directly from the
# browser to Vercel Blob storage (bypassing the ~4.5 MB request body limit of a
# serverless function), so this needs a read-write token. Create a Blob store
# in your Vercel project's Storage tab — the token is added to your environment
# automatically there; only needed manually for local dev against a real store.
BLOB_READ_WRITE_TOKEN=

# Optional but STRONGLY recommended for any public deployment: invited testers
# log in on /login with their first name + APP_PASSWORD to get their own
# isolated profile and import their own books in /library.
APP_PASSWORD=
# Optional separate password for the /admin console. If set, testers who log in
# with APP_PASSWORD can use the learner app and import personal books in
# /library, while only ADMIN_PASSWORD grants access to /admin.
ADMIN_PASSWORD=
# Secret used to sign the login session cookie. Falls back to APP_PASSWORD
# if unset, but a separate random value is better — e.g. `openssl rand -hex 32`.
AUTH_SECRET=
