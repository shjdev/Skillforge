# Copy this file to .env and fill in the values you need.

# Optional: enables AI-assisted book analysis and lesson/quiz generation
# (Admin > Bibliothèque). Without it, PDF import still works but only adds
# the book reference — no lessons are generated. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional but STRONGLY recommended for any public deployment: this app has
# no user accounts (single shared profile), so without a password anyone who
# finds the URL can use the admin panel (including PDF ingestion, which
# spends GEMINI_API_KEY quota) and edit/delete everything. Leave both unset
# for local dev — the gate only activates when APP_PASSWORD is set.
APP_PASSWORD=
# Secret used to sign the login session cookie. Falls back to APP_PASSWORD
# if unset, but a separate random value is better — e.g. `openssl rand -hex 32`.
AUTH_SECRET=
